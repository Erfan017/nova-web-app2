{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-web-app2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6df75abf-45f8-4944-b2be-1ebb7bc868e2","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f0d18246278a4f44a9a51ea49df2f96b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
